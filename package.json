{
  "name": "joshternet-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-coverage-include=scripts/network/**/*.mjs --test-coverage-include=scripts/nlp/**/*.mjs --test-coverage-include=scripts/views/**/*.mjs --test-coverage-exclude=scripts/network/sync.mjs --test-coverage-exclude=scripts/network/preflight.mjs --test-coverage-exclude=scripts/network/generate-elsewhere-glyphs.mjs --test-coverage-exclude=scripts/nlp/sync.mjs --test-coverage-exclude=scripts/nlp/validate-generated.mjs --test-coverage-exclude=scripts/nlp/probe-directory.mjs --test-coverage-exclude=scripts/nlp/scale-probe.mjs --test-coverage-exclude=scripts/views/build.mjs test/network/*.test.mjs test/nlp/*.test.mjs test/views/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=scripts/network/**/*.mjs --test-coverage-include=scripts/nlp/**/*.mjs --test-coverage-include=scripts/views/**/*.mjs --test-coverage-exclude=scripts/network/sync.mjs --test-coverage-exclude=scripts/network/preflight.mjs --test-coverage-exclude=scripts/network/generate-elsewhere-glyphs.mjs --test-coverage-exclude=scripts/nlp/sync.mjs --test-coverage-exclude=scripts/nlp/validate-generated.mjs --test-coverage-exclude=scripts/nlp/probe-directory.mjs --test-coverage-exclude=scripts/nlp/scale-probe.mjs --test-coverage-exclude=scripts/views/build.mjs test/network/*.test.mjs test/nlp/*.test.mjs test/views/*.test.mjs",
    "views:build": "node scripts/views/build.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "test:site": "node --test test/site/*.test.mjs",
    "network:sync": "node scripts/network/sync.mjs",
    "nlp:sync": "node scripts/nlp/sync.mjs",
    "nlp:validate": "node scripts/nlp/validate-generated.mjs",
    "nlp:probe-directory": "node scripts/nlp/probe-directory.mjs",
    "nlp:scale-probe": "node scripts/nlp/scale-probe.mjs",
    "elsewhere:glyphs": "node scripts/network/generate-elsewhere-glyphs.mjs",
    "build": "bash scripts/build.sh",
    "dev": "bash scripts/dev.sh",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "format:data": "prettier --write --ignore-unknown \"_data/*.json\""
  },
  "devDependencies": {
    "@shopify/prettier-plugin-liquid": "1.11.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.63.0",
    "prettier": "3.9.8",
    "sharp": "^0.35.4"
  }
}
