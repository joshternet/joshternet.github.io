{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joshternet-declaration-check",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://joshternet.org"
  },
  "account_id": "f578c2fa49cafc49ee039b79b5663a26",
  "ratelimits": [
    {
      "name": "DECLARATION_CHECK_IP_RATE_LIMITER",
      "namespace_id": "91003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "DECLARATION_CHECK_ORIGIN_RATE_LIMITER",
      "namespace_id": "91004",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
