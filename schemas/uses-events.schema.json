{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joshternet.org/schemas/uses-events.schema.json",
  "title": "Uses monthly event shard",
  "type": "object",
  "required": ["schema_version", "period", "events"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "event_type",
          "observed_at",
          "origin",
          "page_url"
        ],
        "properties": {
          "event_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "event_type": {
            "type": "string",
            "enum": [
              "usage_added",
              "usage_changed",
              "usage_removed",
              "usage_reclassified",
              "source_status_changed",
              "member_eligibility_changed",
              "correction"
            ]
          },
          "observed_at": { "type": "string", "format": "date-time" },
          "origin": { "type": "string", "format": "uri" },
          "page_url": { "type": "string", "format": "uri" },
          "tool_id": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "use_case_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "object" },
          "extractor_version": { "type": "integer" },
          "taxonomy_version": { "type": "integer" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
