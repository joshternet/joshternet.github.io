{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joshternet.org/schemas/content.schema.json",
  "title": "Joshternet normalized content items",
  "type": "object",
  "required": ["schema_version", "item_count"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string" },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["identity", "url"],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "published_at": { "type": "string" },
          "site_origin": { "type": "string" },
          "language": { "type": ["string", "null"] },
          "page_role": { "type": "string" },
          "content_type": { "type": "string" },
          "source_feeds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "url": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "declared_topics": { "type": "array" }
        },
        "additionalProperties": true,
        "not": {
          "required": ["content_html"]
        }
      }
    }
  },
  "additionalProperties": true
}
