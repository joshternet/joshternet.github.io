{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joshternet.org/schemas/topics.schema.json",
  "title": "Joshternet public topic communities",
  "type": "object",
  "required": ["schema_version", "community_count"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string" },
    "community_count": { "type": "integer", "minimum": 0 },
    "membership_rule": { "type": "string" },
    "communities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "label", "sites", "member_count"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "member_count": { "type": "integer", "minimum": 2 },
          "sites": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["origin", "domain"],
              "properties": {
                "origin": { "type": "string" },
                "domain": { "type": "string" },
                "title": { "type": "string" },
                "membership": {
                  "type": "string",
                  "enum": ["declared", "heuristic"]
                },
                "pages": { "type": "array" }
              },
              "additionalProperties": true
            }
          },
          "related_discoveries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["origin", "domain"],
              "properties": {
                "origin": { "type": "string" },
                "domain": { "type": "string" },
                "title": { "type": "string" },
                "discovery": { "type": "string" },
                "note": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "sources": { "type": "array", "items": { "type": "string" } },
          "content": { "type": "array" },
          "first_seen_at": { "type": "string" },
          "last_changed_at": { "type": "string" },
          "stale_since": { "type": "string" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
