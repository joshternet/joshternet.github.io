{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joshternet.org/schemas/mentions.schema.json",
  "title": "Joshternet verified mentions (sparse)",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "type": "integer" },
    "generated_at": { "type": "string" },
    "mention_count": { "type": "integer", "minimum": 0 },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["source_url"],
          "properties": {
            "source_url": { "type": "string" },
            "source_origin": { "type": "string" },
            "relation": { "type": "string" },
            "source_scope": {
              "type": "string",
              "enum": ["participant", "external"]
            },
            "verified_at": { "type": "string" }
          },
          "additionalProperties": true
        }
      }
    }
  },
  "additionalProperties": true
}
