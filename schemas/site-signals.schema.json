{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joshternet.org/schemas/site-signals.schema.json",
  "title": "Joshternet site signals",
  "description": "Per-origin crawl signals. community_eligible means the evidence qualifies for a public topic community, not that the publisher opted in beyond /.well-known/josh.",
  "type": "object",
  "required": ["schema_version", "origins"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string" },
    "origins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin"],
        "properties": {
          "origin": { "type": "string" },
          "crawled_at": { "type": "string" },
          "coverage": {
            "type": "object",
            "properties": {
              "pages_discovered": { "type": "integer" },
              "pages_fetched": { "type": "integer" },
              "fetch_limit": { "type": "integer" },
              "limit_reached": { "type": "boolean" },
              "selection_strategy": { "type": "string" }
            },
            "additionalProperties": true
          },
          "pages": { "type": "array" },
          "declared_topics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "observed_at": { "type": "string", "format": "date-time" }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "subject_signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "observed_at": { "type": "string", "format": "date-time" }
                    },
                    "additionalProperties": true
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "subjects": {
            "type": "array",
            "description": "Legacy projection; temporary compatibility"
          },
          "outbound_links": { "type": "array" },
          "community_slugs": { "type": "array", "items": { "type": "string" } },
          "stats": { "type": "object" },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
